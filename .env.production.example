# GTU Blog production-like container deployment example
# Copy to .env.production (ignored) and replace every placeholder before deployment.

# Public origin / proxy
PUBLIC_ORIGIN=https://blog.example.com
PROXY_PORT=80

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# External MySQL
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=gtublog
MYSQL_USER=gtublog
MYSQL_PASSWORD=replace-with-production-password

# Frontend runtime
GTUBLOG_SITE_URL=https://blog.example.com
GTUBLOG_PUBLIC_API_BASE_URL=http://backend:8080/api/v1/public
GTUBLOG_APPLICATION_API_BASE_URL=http://backend:8080/api/v1
NEXT_PUBLIC_GTUBLOG_APPLICATION_API_BASE_URL=/api/v1

# Authentication
AUTH_ALLOWED_ORIGIN=https://blog.example.com
AUTH_COOKIE_SECURE=true
AUTH_ISSUER=https://blog.example.com
AUTH_AUDIENCE=gtublog-admin
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-production-admin-password
ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator
AUTH_PUBLIC_KEY_PEM=replace-with-production-public-key
AUTH_PRIVATE_KEY_PEM=replace-with-production-private-key

# Automation pipeline
AUTOMATION_COLLECTION_ALLOWED_PRIVATE_HOSTS=
AUTOMATION_WORKER_SHARED_TOKEN=replace-with-production-worker-token
AUTOMATION_REVALIDATION_BASE_URL=https://blog.example.com
AUTOMATION_REVALIDATION_SHARED_SECRET=replace-with-production-revalidation-secret

# Generation worker
GENERATION_BACKEND_BASE_URL=http://backend:8080
GENERATION_WORKER_TOKEN=replace-with-production-worker-token
GENERATION_WORKER_ID=gtublog-worker
GENERATION_PROVIDER=fake
CODEX_API_KEY=
GENERATION_CODEX_ENV_ISOLATION_APPROVED=false
GENERATION_CODEX_CANARY_ATTESTATION_PATH=

# Optional ops profile
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=ops-admin
GRAFANA_ADMIN_PASSWORD=replace-with-production-grafana-password
