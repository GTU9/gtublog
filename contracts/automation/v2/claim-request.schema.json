{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtublog.dev/contracts/automation/v2/claim-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["workerId", "supportedProviders", "supportedSchemaVersions"],
  "properties": {
    "workerId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "supportedProviders": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "supportedSchemaVersions": { "type": "array", "minItems": 1, "maxItems": 20, "contains": { "const": "automation-job-v2" }, "items": { "type": "string", "minLength": 1, "maxLength": 64 } }
  }
}
