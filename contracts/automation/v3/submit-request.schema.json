{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtublog.dev/contracts/automation/v3/submit-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["terminalSubmissionId", "payloadDigest", "workerId", "providerName", "promptVersion", "schemaVersion"],
  "properties": {
    "terminalSubmissionId": { "type": "string", "format": "uuid" },
    "payloadDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "workerId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "providerName": { "type": "string", "minLength": 1, "maxLength": 64 },
    "promptVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "schemaVersion": { "const": "automation-job-v3" },
    "draft": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "excerpt", "contentMarkdown", "citationSnapshotIds", "taxonomy"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "excerpt": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "contentMarkdown": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "citationSnapshotIds": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
        "taxonomy": { "type": "object", "additionalProperties": false, "required": ["categoryId", "tagIds"], "properties": {
          "categoryId": { "type": "integer", "minimum": 1 },
          "tagIds": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "integer", "minimum": 1 } }
        } }
      }
    },
    "failureReason": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "oneOf": [
    { "required": ["draft"], "not": { "required": ["failureReason"] } },
    { "required": ["failureReason"], "not": { "required": ["draft"] } }
  ]
}
