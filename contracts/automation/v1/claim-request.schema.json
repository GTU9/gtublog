{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtublog.dev/contracts/automation/v1/claim-request.schema.json",
  "type": "object",
  "required": ["workerId", "supportedProviders", "supportedSchemaVersions"],
  "properties": {
    "workerId": { "type": "string", "minLength": 1 },
    "supportedProviders": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "supportedSchemaVersions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": false
}
