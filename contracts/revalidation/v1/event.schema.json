{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gtublog.dev/contracts/revalidation/v1/event.schema.json",
  "title": "Signed public cache revalidation event",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "eventKey", "postId", "slug", "tags", "paths"],
  "properties": {
    "version": { "const": 1 },
    "eventKey": { "type": "string", "format": "uuid", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "postId": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "slug": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[\\p{L}\\p{N}]+(?:-[\\p{L}\\p{N}]+)*$" },
    "tags": { "type": "array", "const": ["public-posts"] },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "oneOf": [
          { "enum": ["/", "/archive", "/search", "/rss.xml", "/sitemap.xml"] },
          { "pattern": "^/posts/[\\p{L}\\p{N}]+(?:-[\\p{L}\\p{N}]+)*$", "maxLength": 167 },
          { "pattern": "^/categories/[\\p{L}\\p{N}]+(?:-[\\p{L}\\p{N}]+)*$", "maxLength": 172 },
          { "pattern": "^/tags/[\\p{L}\\p{N}]+(?:-[\\p{L}\\p{N}]+)*$", "maxLength": 166 }
        ]
      }
    }
  }
}
