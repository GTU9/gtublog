{
  "name": "@gtublog/generation-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": "./dist/index.js",
  "bin": { "gtublog-generation-worker": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint . --max-warnings=0",
    "spike:codex": "tsx scripts/codex-sdk-spike.ts",
