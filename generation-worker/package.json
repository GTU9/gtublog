  },
  "dependencies": {
    "@openai/codex-sdk": "0.144.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.2",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "tsx": "4.22.4",
    "typescript-eslint": "8.62.0",
    "vitest": "4.1.9"
  }
}
