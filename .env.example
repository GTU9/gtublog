# Local development placeholders only. Replace these values in an ignored .env file.
MYSQL_DATABASE=gtublog
MYSQL_USER=gtublog
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306

SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=local-admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# Codex SDK remains the preferred candidate until the Phase 0 unattended-auth gate passes.
GENERATION_PROVIDER=fake
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
