# Local development placeholders only. Replace these values in an ignored .env file.
MYSQL_DATABASE=gtublog
MYSQL_USER=gtublog
MYSQL_PASSWORD=replace-with-local-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PORT=3306

SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
FRONTEND_PORT=3000
AUTH_ALLOWED_ORIGIN=http://localhost:3000
AUTH_ISSUER=https://gtublog.local
AUTH_AUDIENCE=gtublog-admin
AUTH_ACCESS_TOKEN_TTL=PT10M
AUTH_REFRESH_TOKEN_TTL=P14D
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-local-admin-password
ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator
AUTH_PUBLIC_KEY_PEM=
AUTH_PRIVATE_KEY_PEM=
AUTOMATION_COLLECTION_ALLOWED_PRIVATE_HOSTS=
AUTOMATION_RUN_PIPELINE_LEASE_DURATION=PT10M
AUTOMATION_RUN_MAX_DURATION=PT30M
AUTOMATION_RUN_RECOVERY_INTERVAL=PT1M
AUTOMATION_WORKER_SHARED_TOKEN=replace-with-local-worker-token
AUTOMATION_REVALIDATION_BASE_URL=
AUTOMATION_REVALIDATION_SHARED_SECRET=replace-with-local-revalidation-secret
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=local-admin
GRAFANA_ADMIN_PASSWORD=replace-with-local-grafana-password

# Codex SDK remains the preferred candidate until the Phase 0 unattended-auth gate passes.
GENERATION_PROVIDER=fake
CODEX_API_KEY=
CODEX_ACCESS_TOKEN=
GENERATION_BACKEND_BASE_URL=http://host.docker.internal:8080
GENERATION_WORKER_TOKEN=replace-with-local-worker-token
GENERATION_WORKER_ID=
GENERATION_POLL_INTERVAL_MS=5000
GENERATION_ERROR_BACKOFF_MIN_MS=1000
GENERATION_ERROR_BACKOFF_MAX_MS=30000
GENERATION_REQUEST_TIMEOUT_MS=10000
GENERATION_HEARTBEAT_INTERVAL_MS=30000
GENERATION_TIMEOUT_MS=240000
GENERATION_LEASE_SAFETY_MARGIN_MS=45000
GENERATION_SHUTDOWN_GRACE_MS=20000
GENERATION_READINESS_MAX_AGE_MS=120000
# Set only after the clean-container prompt-injection canary proves shell environment isolation.
GENERATION_CODEX_ENV_ISOLATION_APPROVED=false
# Production ignores the boolean above and requires a mounted JSON attestation whose
# imageDigest matches this immutable image digest.
GENERATION_CODEX_CANARY_ATTESTATION_PATH=
